# Secrets never belong in the memory: keep such files out of git entirely
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*

# Editor state and trash folders (any editor; per device, never shared)
.obsidian/
.vscode/
.idea/
.trash/

# Caches (search indexes and future embeddings are rebuilt, never committed)
.cache/
node_modules/

# Upgrade backups and proposed files (per machine, never committed)
.memory-kit/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
